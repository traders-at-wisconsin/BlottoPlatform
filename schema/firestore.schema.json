          "default": 4,
          "exclusiveMinimum": 0,
          "title": "Groups",
          "type": "integer"
        },
        "soldiers": {
          "default": 100,
          "exclusiveMinimum": 0,
          "title": "Soldiers",
          "type": "integer"
        }
      },
      "title": "GameConfig",
      "type": "object"
