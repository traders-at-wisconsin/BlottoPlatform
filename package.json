{
  "name": "blotto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test tests/*.test.ts",
    "emulators": "firebase emulators:start --only auth,database --project tradersatwisconsinblotto",
    "dev:emulator": "VITE_USE_EMULATOR=true vite",
    "dryrun": "firebase emulators:exec --only auth,database --project tradersatwisconsinblotto \"VITE_USE_EMULATOR=true tsx scripts/dryrun.ts\"",
    "bots": "BOTS_ONLY=true VITE_USE_EMULATOR=true tsx scripts/dryrun.ts"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.34.2",
    "oxlint": "^1.89.0",
    "tsx": "^4.19.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
